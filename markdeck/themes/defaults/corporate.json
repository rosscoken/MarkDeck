{
  "schema_version": "1.0",
  "metadata": {
    "name": "Corporate Theme",
    "version": "1.0.0",
    "author": "MarkDeck",
    "description": "Professional corporate presentation theme with clean design",
    "license": "MIT",
    "tags": ["corporate", "professional", "business", "clean"]
  },
  "master_slides": {
    "title": {
      "layout": "title_slide",
      "placeholders": {
        "title": {
          "type": "title",
          "position": {"x": 0.5, "y": 0.35},
          "size": {"width": 8.5, "height": 1.5},
          "styling": {
            "font": {
              "family": "Calibri",
              "size": 44,
              "weight": "bold",
              "color": "#1f4e79"
            },
            "alignment": "center"
          }
        },
        "subtitle": {
          "type": "content",
          "position": {"x": 0.5, "y": 4.5},
          "size": {"width": 8.5, "height": 1.0},
          "styling": {
            "font": {
              "family": "Calibri",
              "size": 24,
              "weight": "normal",
              "color": "#595959"
            },
            "alignment": "center"
          }
        }
      },
      "background": {
        "type": "gradient",
        "gradient": {
          "start_color": "#ffffff",
          "end_color": "#f5f5f5",
          "direction": "vertical"
        }
      }
    },
    "content": {
      "layout": "content_slide",
      "placeholders": {
        "title": {
          "type": "title",
          "position": {"x": 0.5, "y": 0.5},
          "size": {"width": 8.5, "height": 1.0},
          "styling": {
            "font": {
              "family": "Calibri",
              "size": 32,
              "weight": "bold",
              "color": "#1f4e79"
            }
          }
        },
        "content": {
          "type": "content",
          "position": {"x": 0.5, "y": 1.8},
          "size": {"width": 8.5, "height": 5.0},
          "styling": {
            "font": {
              "family": "Calibri",
              "size": 18,
              "weight": "normal",
              "color": "#404040"
            }
          }
        }
      },
      "background": {
        "type": "solid",
        "color": "#ffffff"
      }
    },
    "section": {
      "layout": "section_slide",
      "placeholders": {
        "title": {
          "type": "title",
          "position": {"x": 0.5, "y": 3.0},
          "size": {"width": 8.5, "height": 1.5},
          "styling": {
            "font": {
              "family": "Calibri",
              "size": 36,
              "weight": "bold",
              "color": "#ffffff"
            },
            "alignment": "center"
          }
        }
      },
      "background": {
        "type": "solid",
        "color": "#1f4e79"
      }
    }
  },
  "slide_types": {
    "mapping": {
      "header1": "title",
      "header2": "section",
      "header3": "content",
      "content": "content",
      "list": "content",
      "image": "content",
      "table": "content",
      "code": "content"
    }
  },
  "styling": {
    "fonts": {
      "title": {
        "family": "Calibri",
        "size": 32,
        "weight": "bold",
        "color": "#1f4e79"
      },
      "heading": {
        "family": "Calibri",
        "size": 24,
        "weight": "bold",
        "color": "#1f4e79"
      },
      "body": {
        "family": "Calibri",
        "size": 18,
        "weight": "normal",
        "color": "#404040"
      },
      "code": {
        "family": "Consolas",
        "size": 14,
        "weight": "normal",
        "color": "#000000"
      }
    },
    "colors": {
      "primary": "#1f4e79",
      "secondary": "#5b9bd5",
      "accent": "#70ad47",
      "background": "#ffffff",
      "text": "#404040",
      "palette": [
        "#1f4e79",
        "#5b9bd5",
        "#70ad47",
        "#ffc000",
        "#c55a5a"
      ]
    },
    "spacing": {
      "margins": {
        "top": 0.5,
        "right": 0.5,
        "bottom": 0.5,
        "left": 0.5
      },
      "padding": {
        "top": 0.25,
        "right": 0.25,
        "bottom": 0.25,
        "left": 0.25
      },
      "line_spacing": 1.2
    },
    "animations": {
      "enabled": false
    }
  },
  "objects": {
    "text_boxes": {
      "auto_fit": true,
      "word_wrap": true,
      "default_styling": {
        "border": "none",
        "fill": "transparent"
      }
    },
    "images": {
      "default_size": {
        "width": 4.0,
        "height": 3.0
      },
      "quality": 90,
      "compression": "medium"
    },
    "tables": {
      "header_styling": {
        "background_color": "#1f4e79",
        "font_color": "#ffffff",
        "font_weight": "bold"
      },
      "row_styling": {
        "alternate_background": "#f2f2f2"
      },
      "border_styling": {
        "color": "#cccccc",
        "width": 1
      }
    },
    "charts": {
      "default_type": "bar",
      "color_scheme": [
        "#1f4e79",
        "#5b9bd5",
        "#70ad47",
        "#ffc000",
        "#c55a5a"
      ]
    }
  }
}